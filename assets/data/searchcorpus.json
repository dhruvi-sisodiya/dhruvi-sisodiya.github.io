---
layout: null
---
[ 
{% for post in site.posts %} 
{ 
"title"    : "{{ post.title | strip_html | escape }}", 
"desc"     : "{{ post.excerpt | strip_html | strip_newlines | escape | truncatewords: 30 }}", 
"content"  : "{{ post.content | strip_html | strip_newlines | escape | truncatewords: 150 }}",
"category" : "{{ post.tags | join: ', ' }}", 
"url"      : "{{ site.baseurl }}{{ post.url }}", 
"date"     : "{{ post.date | date: '%B %e, %Y' }}" 
}, 
{% endfor %}
{% for page in site.pages %}{% unless page.url contains 'feed.xml' or page.url contains '404' or page.url contains 'tags' %} 
{ 
"title"    : "{{ page.title | default: page.name | strip_html | escape }}", 
"desc"     : "{{ page.subtitle | default: page.title | strip_html | escape }}", 
"content"  : "{{ page.content | strip_html | strip_newlines | escape | truncatewords: 150 }}",
"category" : "{{ page.tags | join: ', ' | default: 'page' }}", 
"url"      : "{{ site.baseurl }}{{ page.url }}", 
"date"     : "{{ page.date | date: '%B %e, %Y' | default: 'January 1, 1970' }}" 
}{% unless forloop.last %},{% endunless %} 
{% endunless %}{% endfor %} 
]
